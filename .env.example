# compose と各サービスが参照する設定。.env にコピーして使う
DB_HOST=db
DB_PORT=5432
DB_DB=changeme
DB_USER=changeme
DB_PASSWORD=changeme

# session が JWT の署名に使う。空なら make .env がランダムな値を書き込む
JWT_SECRET_KEY=

# idp が JWT（RS256）の署名に使う秘密鍵（base64 の PEM）。空なら make .env が生成する
IDP_SIGNING_KEY=
# JWT の iss / aud。iss はホストから見た idp の URL
IDP_ISS=http://localhost:8082
IDP_AUD=handson

# migrate が作る demo ユーザー（UI の契約テストで使う）。空なら作らない
IDP_DEMO_EMAIL=demo@example.com
IDP_DEMO_PASSWORD=demo-password
